{
  "name": "medtriage-ai",
  "version": "2.0.0",
  "private": true,
  "description": "MedTriage AI - healthcare triage platform built on a four-layer architecture",
  "type": "module",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
